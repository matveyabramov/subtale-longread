{
  "name": "subtale-longread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "assets:generate": "node scripts/generate-runtime-assets.mjs",
    "assets:check": "node scripts/generate-runtime-assets.mjs --check && node scripts/check-assets.mjs",
    "build": "npm run assets:generate && npm run typecheck && vite build",
    "build:explorer-qa": "npm run assets:generate && npm run typecheck && vite build --config vite.explorer-qa.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
